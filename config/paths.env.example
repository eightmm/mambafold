# External inputs for the mambafold-clean data pipeline.
#
# Everything the pipeline reads from outside this repository is declared here
# rather than hidden in a script, so the corpus provenance is auditable in one
# place. Nothing here is written to; the pipeline only reads.
#
# Sourced by pipeline/run_all.sh and passed explicitly to the Python stages.

# ---------------------------------------------------------------- structures
# Boltz-preprocessed RCSB records and the manifest the reference implementation
# filters on. This archive is a fixed 2024-12-20 snapshot.
BOLTZ_ROOT=/path/to/rcsb_processed_targets_full_2024-12-20
BOLTZ_STRUCTURES="${BOLTZ_ROOT}/structures"
BOLTZ_MANIFEST="${BOLTZ_ROOT}/manifest.json"

# The previous track's symlink farm over the same records. Used only to copy
# link targets; the pipeline can fall back to BOLTZ_STRUCTURES directly.
LEGACY_STRUCTURE_FARM=/path/to/previous-track-root/data/rcsb_boltz_official_full

# ---------------------------------------------------------------- embeddings
# ESMC-6B embeddings already computed by the previous track. Reused, never
# recomputed, wherever the sequence is unchanged. RCSB is sequence-addressed;
# AFDB is still under legacy occurrence names keyed by the v6 entry id.
LEGACY_ESMC_RCSB=/path/to/previous-track-root/data/rcsb_esmc6b_official_full
LEGACY_ESMC_AFDB=/path/to/previous-track-root/data/afdb_swissprot_esmc6b
LEGACY_AFDB_V6_NPZ=/path/to/previous-track-root/data/afdb_swissprot/npz

# -------------------------------------------------------------------- remote
SIMPLEFOLD_LIST_URL=https://ml-site.cdn-apple.com/models/simplefold/swissprot_list.csv
AFDB_V4_TAR_URL=https://ftp.ebi.ac.uk/pub/databases/alphafold/v4/swissprot_cif_v4.tar
AFDB_V4_TAR_BYTES=39471090688

# ---------------------------------------------------------------- admission
RELEASE_CUTOFF=2020-05-01
MAX_RESOLUTION=5.0
# 'boltz' reproduces the reference pipeline exactly (its resolution field is
# 0.0 for every record, so the filter is a no-op there). 'rcsb_api' applies the
# real resolutions and yields a stricter corpus than SimpleFold trained on.
RESOLUTION_SOURCE=boltz

# The frozen validation ids carried over from the previous track's MMseqs2
# 30%-identity clustering. Only their intersection with the admitted pool is
# used, so the two sets stay cluster-disjoint.

# ---------------------------------------------------------------- toolchain
# This project has no environment of its own yet; it borrows the previous
# track's, which already has torch, mamba-ssm, and the ESM stack built.
MFCLEAN_PYTHON="/path/to/previous-track-root/.venv/bin/python"
MMSEQS_BIN="/path/to/previous-track-root/tools/mmseqs/bin/mmseqs"

# --------------------------------------------------------------- benchmarks
# Frozen reference assets and the OpenStructure 2.9.1 scorer are large external
# inputs. Keep them outside Git and declare them here just like the corpus.
CAMEO22_REFERENCE_ROOT="/path/to/previous-track-root/data/simplefold_official/testsets/cameo22"
CASP14_REFERENCE_DIR="/path/to/frozen/casp14_full70"
OPENSTRUCTURE_OST="/path/to/openstructure-2.9.1/bin/ost"

# The interpreter above is the previous track's venv, which carries an editable
# install of `mambafold` pointing at that root's src/. A bare `import mambafold`
# therefore resolves to the previous track's code, silently. PYTHONPATH is
# consulted before site-packages, so this puts this root first. Every script that
# sources this file gets it; nothing may rely on being run from a particular cwd.
export PYTHONPATH="${MFCLEAN_ROOT:-$PWD}/src${PYTHONPATH:+:$PYTHONPATH}"
